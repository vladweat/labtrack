# Local development only. Do not use these credentials outside this machine.
POSTGRES_DB=labtrack
POSTGRES_USER=labtrack
POSTGRES_PASSWORD=labtrack-local-only-change-me

# Host ports; services bind to loopback only.
POSTGRES_PORT=5432
REDIS_PORT=6379

# Local API settings. Replace the key before using a non-development environment.
APP_ENV=development
JWT_SECRET_KEY=local-development-secret-change-before-deploying-000000000000
JWT_ACCESS_TOKEN_MINUTES=15
